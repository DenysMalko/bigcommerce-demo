    "consola": "^3.4.2",
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^10.0.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.0",
    "lodash.kebabcase": "^4.1.1",
